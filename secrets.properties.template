# Firebase Configuration Template
# Copy this file to 'secrets.properties' and fill with your Firebase project values
# DO NOT commit the actual secrets.properties file to version control

# Get these values from your Firebase Console -> Project Settings -> General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_PROJECT_NUMBER=your_firebase_project_number_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
FIREBASE_APP_ID=your_firebase_app_id_here

# Instructions:
# 1. Go to https://console.firebase.google.com/
# 2. Open your Firebase project
# 3. Go to Project Settings (gear icon)
# 4. In the "General" tab, find your app
# 5. Copy the values from google-services.json to this file
# 6. Rename this file to 'secrets.properties'
